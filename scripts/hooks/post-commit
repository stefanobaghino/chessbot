#!/usr/bin/env bash
# Launch the local CI/CD pipeline in the background for the new commit.
ROOT="$(git rev-parse --show-toplevel)"
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
mkdir -p "$ROOT/ci"
nohup "$ROOT/scripts/ci.sh" >> "$ROOT/ci/ci.log" 2>&1 < /dev/null &
echo "post-commit: CI started in background (ci/ci.log)"
