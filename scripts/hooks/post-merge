#!/usr/bin/env bash
# After a merge into main (fast-forward included), release the new commits.
ROOT="$(git rev-parse --show-toplevel)"
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
mkdir -p "$ROOT/ci"
nohup "$ROOT/scripts/ci.sh" >> "$ROOT/ci/ci.log" 2>&1 < /dev/null &
echo "post-merge: CI started in background (ci/ci.log)"
